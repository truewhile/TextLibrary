{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cfnode",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/d/*", "/v/*", "/s/*"]
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "cfnode-store"
    }
  ],
  "observability": {
    "enabled": true
  }
}
